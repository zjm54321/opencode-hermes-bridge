{
  "name": "opencode-hermes-bridge",
  "version": "0.1.2",
  "description": "Native OpenCode tools for collaborating with an existing Hermes Gateway, with durable jobs and original-file transfer.",
  "type": "module",
  "license": "GPL-3.0-or-later",
  "repository": { "type": "git", "url": "git+https://github.com/zjm54321/opencode-hermes-bridge.git" },
  "homepage": "https://github.com/zjm54321/opencode-hermes-bridge#readme",
  "bugs": { "url": "https://github.com/zjm54321/opencode-hermes-bridge/issues" },
  "engines": { "node": ">=22.14.0" },
  "publishConfig": { "access": "public", "registry": "https://registry.npmjs.org/" },
  "exports": { ".": "./dist/index.js", "./core": "./dist/core.js", "./source": "./src/index.ts" },
  "files": ["dist", "src", "docs"],
  "scripts": {
    "test": "bun test tests/unit",
    "test:integration": "bun test tests/integration --only-failures",
    "typecheck": "tsc --noEmit",
    "build": "bun build src/index.ts src/core.ts --target=node --outdir=dist --external @opencode/plugin",
    "mcp:start": "bun run mcp/index.ts",
    "test:mcp": "bun test tests/mcp-*.test.ts",
    "typecheck:mcp": "tsc --noEmit -p mcp/tsconfig.json"
  },
  "dependencies": {
    "@opencode/plugin": "2.0.24",
    "@modelcontextprotocol/server": "2.3.1",
    "@modelcontextprotocol/node": "2.1.1",
    "zod": "4.6.7",
    "ipaddr.js": "2.5.0"
  },
  "devDependencies": { "@types/bun": "1.3.11", "typescript": "5.9.3" }
}
